# Salin file ini menjadi `.env`, lalu isi nilainya.
# Jangan pernah commit `.env` — file itu sudah masuk .gitignore.

# Wajib. Ambil dari https://platform.deepseek.com/api_keys
EXPO_PUBLIC_DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Opsional. Ganti endpoint untuk mock server saat testing.
# Default: https://api.deepseek.com
# EXPO_PUBLIC_DEEPSEEK_BASE_URL=http://localhost:8787

# Opsional. Paksa mode estimasi rasio (tanpa MediaPipe) untuk menguji fallback.
# EXPO_PUBLIC_FORCE_FACE_FALLBACK=1

# Wajib untuk simulasi Virtual Try-On. Ambil dari https://fal.ai/dashboard/keys
EXPO_PUBLIC_FAL_KEY=fal-xxxxxxxxxxxxxxxxxxxxxxxx

# Opsional. Arahkan semua request Fal.ai ke proxy backend sendiri (produksi) atau
# mock server (testing). Kalau diisi, EXPO_PUBLIC_FAL_KEY tidak wajib ada di aplikasi.
# Mock bawaan repo ini: `npm run mock:ai` lalu pakai URL di bawah.
# EXPO_PUBLIC_FAL_PROXY_URL=http://localhost:8787/fal-api
