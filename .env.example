# Salin file ini menjadi `.env`, lalu isi nilainya.
# Jangan pernah commit `.env` — file itu sudah masuk .gitignore.

# Wajib untuk rekomendasi gaya. Ambil dari https://aistudio.google.com/apikey
# Catatan: langganan Gemini Pro TIDAK memberi akses API; kuota mengikuti project.
EXPO_PUBLIC_GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxx

# Opsional. Model utama + rantai fallback kalau Gemini membalas 503/429.
# Default: gemini-3.1-flash-lite dan fallback gemini-3.5-flash-lite, gemini-3-flash-preview
# EXPO_PUBLIC_GEMINI_MODEL=gemini-3.1-flash-lite
# EXPO_PUBLIC_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3-flash-preview

# Opsional. Arahkan request ke mock server saat testing tanpa kuota.
# `npm run mock:ai` lalu buka http://localhost:8787/gemini/set?mode=fail untuk uji error.
# EXPO_PUBLIC_GEMINI_BASE_URL=http://localhost:8787/v1beta

# Opsional. Paksa mode estimasi rasio (tanpa MediaPipe) untuk menguji fallback.
# EXPO_PUBLIC_FORCE_FACE_FALLBACK=1

# ---------------------------------------------------------------------------
# VIRTUAL TRY-ON
# mock   = gambar contoh dari mock server (gratis, UI memberi label "contoh render")
# gemini = Gemini image generation, harga ±$0.03–0.07/gambar, TIDAK ada free tier
# fal    = Fal.ai Kontext (kode lama)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_TRYON_MODE=mock

# Dipakai kalau TRYON_MODE=gemini.
# EXPO_PUBLIC_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Dipakai kalau TRYON_MODE=fal. Ambil dari https://fal.ai/dashboard/keys
# EXPO_PUBLIC_FAL_KEY=fal-xxxxxxxxxxxxxxxxxxxxxxxx

# Atau arahkan request Fal ke proxy backend / mock server.
# Mock bawaan repo: `npm run mock:ai` lalu pakai URL di bawah.
# EXPO_PUBLIC_FAL_PROXY_URL=http://localhost:8787/fal-api
